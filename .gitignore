# ---------------------------------------------------------------------------
#  EcoWealth — repository ignore rules
#  Secrets never enter the repo; runtime artefacts never get committed.
# ---------------------------------------------------------------------------

# Local configuration (database credentials, payment accounts, flags)
config.local.php

# Uploaded media (directories are created at runtime; keep the guards)
system/public/uploads/*
!system/public/uploads/.gitkeep
!system/public/uploads/.htaccess

# Cron runtime storage (logs are also covered by *.log; locks are not)
system/storage/logs/*
!system/storage/logs/.gitkeep
system/storage/locks/*
!system/storage/locks/.gitkeep

# Install lock written by the CLI/web installers (IR-3); runtime state, never committed
system/storage/install.lock

# Logs and one-off dumps
*.log
backup_*.sql
backups/

# Exception: committed QA evidence transcripts are evidence, not runtime logs
!docs/qa/evidence/**/*.log

# Test scratch space
tests/tmp/
system/tests/tmp/
